{
  "name": "runshape-workspace",
  "private": true,
  "packageManager": "npm@11.21.0",
  "workspaces": [
    "packages/trace",
    "packages/architecture",
    "packages/core",
    "packages/webview",
    "packages/extension",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build -w packages/webview && npm run build -w packages/extension && npm run build -w packages/cli",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces && tsc -p recorder-ts",
    "test:e2e": "npm run build && npm run test:e2e -w packages/extension",
    "view-diff": "sh tools/view-diff/view-diff.sh",
    "self-review": "sh recorder-ts/self-review.sh"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "@types/node": "22.20.5",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2"
  }
}
