{
  "name": "runshape",
  "displayName": "Runshape",
  "description": "See how requests flow through your app, recorded from its tests.",
  "version": "0.1.0",
  "private": true,
  "publisher": "runshape",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/.runshape/traces/latest.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "runshape.open",
        "title": "Runshape: Open Runtime View"
      },
      {
        "command": "runshape.reload",
        "title": "Runshape: Reload Traces"
      },
      {
        "command": "runshape.suggestZone",
        "title": "Runshape: Suggest Zone for Component\u2026"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "test:e2e": "node build.mjs && node test/e2e/run.mjs"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "esbuild": "0.28.2",
    "@vscode/test-electron": "3.1.0"
  },
  "dependencies": {
    "@runshape/core": "0.1.0"
  }
}
