ers_test.go::TestPlaceThenFetchAnOrder","file":"scenarios/01792014050365030000-50856.json","outcome":"passed","durationUs":1250,"eventCount":115,"recorderErrors":0},{"nodeid":"e2e/orders_test.go::TestAnInvalidOrderListsEveryProblem","file":"scenarios/01792014050365721000-50856.json","outcome":"passed","durationUs":263,"eventCount":66,"recorderErrors":0},{"nodeid":"e2e/orders_test.go::TestAnUnknownOrderIsNotFound","file":"scenarios/01792014050366436000-50856.json","outcome":"passed","durationUs":190,"eventCount":60,"recorderErrors":0},{"nodeid":"e2e/orders_test.go::TestAMalformedOrderIsRefusedBeforeTheService","file":"scenarios/01792014050366871000-50856.json","outcome":"passed","durationUs":188,"eventCount":48,"recorderErrors":0},{"nodeid":"internal/orders/order_test.go::TestTotalAddsEveryItem","file":"scenarios/01792014050725408000-50872.json","outcome":"passed","durationUs":118,"eventCount":9,"recorderErrors":0}],"sessionProblems":[],"sources":{"cmd/shop/main.go":["// Command shop serves the orders API.","package main","","import (","\t\"log/slog\"","\t\"net/http\"","\t\"os\"","","\t\"example.com/shop/internal/app\"",")","","func main() {","\tlogger := slog.New(slog.NewJSONHandler(os.Stdout, nil)).With(\"service\", \"shop\")","\taddress := \":8080\"","\tlogger.Info(\"starting\", \"address\", address)","\tif err := http.ListenAndServe(address, app.New(logger)); err != nil {","\t\tlogger.Error(\"stopped\", \"error\", err)","\t\tos.Exit(1)","\t}","}",""],"internal/app/app.go":["// Package app is the composition root: the only place that knows every layer.","package app","","import (","\t\"log/slog\"","\t\"net/http\"","","\t\"example.com/shop/internal/orders\"","\t\"example.com/shop/internal/storage\"","\t\"example.com/shop/internal/web\"",")","","// New wires storage, the orders service and the HTTP adapter into one handler, as main runs it.","func New(logger *slog.Logger) http.Handler {","\trepository := storage.NewMemoryRepository()","\tservice := orders.NewService(repository)","\treturn web.NewHandler(service, logger)","}",""],"internal/orders/order.go":["// Package orders is the domain: orders, the rules for placing them, and the port to store them.","package orders","","import (","\t\"errors\"","\t\"fmt\"",")","","// Item is one line of an order.","type Item struct {","\tSKU      string `json:\"sku\"`","\tQuantity int    `json:\"quantity\"`","\t// PriceCents avoids float rounding in totals.","\tPriceCents int `json:\"priceCents\"`","}","","// Order is what a customer placed.","type Order struct {","\tID       string `json:\"id\"`","\tCustomer string `json:\"customer\"`","\tItems    []Item `json:\"items\"`","}","","// MaxQuantity is the most of one SKU a single order may hold.","const MaxQuantity = 100","","// ErrNotFound is returned for an order id nobody placed.","var ErrNotFound = errors.New(\"order not found\")","","// TotalCents is what the order costs.","func (o Order) TotalCents() int {","\ttotal := 0","\tfor _, item := range o.Items {","\t\ttotal += item.Quantity * item.PriceCents","\t}","\treturn total","}","","// Problems lists everything wrong with the order, not just the first thing.","func (o Order) Problems() []string {","\tvar problems []string","\tif o.Customer == \"\" {","\t\tproblems = append(problems, \"customer is required\")","\t}","\tif len(o.Items) == 0 {","\t\tproblems = append(problems, \"an order needs at least one item\")","\t}","\tfor i, item := range o.Items {","\t\tif item.Quantity \u003c 1 || item.Quantity \u003e MaxQuantity {","\t\t\tproblems = append(problems, fmt.Sprintf(\"item %d: quantity must be 1 to %d\", i, MaxQuantity))","\t\t}","\t\tif item.PriceCents \u003c 0 {","\t\t\tproblems = append(problems, fmt.Sprintf(\"item %d: price can't be negative\", i))","\t\t}","\t}","\treturn problems","}",""],"internal/orders/service.go":["package orders","","import \"fmt\"","","// Repository is the port the service stores orders through; storage adapters implement it.","type Repository interface {","\tSave(order Order) error","\tFind(id string) (Order, error)","}","","// Placement is the outcome of placing an order: the order, or every reason it was refused.","type Placement struct {","\tOrder    Order    `json:\"order\"`","\tValid    bool     `json:\"valid\"`","\tProblems []string `json:\"problems,omitempty\"`","}","","// Service places and looks up orders.","type Service struct {","\trepository Repository","\tnextID     int","}","","// NewService builds a service on a repository.","func NewService(repository Repository) *Service {","\treturn \u0026Service{repository: repository}","}","","// Place validates and stores an order. A refused order is not an error: it's a Placement with","// its problems.","func (s *Service) Place(order Order) (Placement, error) {","\tif problems := order.Problems(); len(problems) \u003e 0 {","\t\treturn Placement{Order: order, Valid: false, Problems: problems}, nil","\t}","\ts.nextID++","\torder.ID = fmt.Sprintf(\"ord-%d\", s.nextID)","\tif err := s.repository.Save(order); err != nil {","\t\treturn Placement{}, fmt.Errorf(\"saving order: %w\", err)","\t}","\treturn Placement{Order: order, Valid: true}, nil","}","","// Get returns a placed order.","func (s *Service) Get(id string) (Order, error) {","\treturn s.repository.Find(id)","}",""],"internal/storage/memory.go":["// Package storage holds the repositories the domain stores orders through.","package storage","","import (","\t\"sync\"","","\t\"example.com/shop/internal/orders\"",")","","// MemoryRepository keeps orders in memory; it implements orders.Repository.","type MemoryRepository struct {","\tmu     sync.Mutex","\torders map[string]orders.Order","}","","// NewMemoryRepository builds an empty repository.","func NewMemoryRepository() *MemoryRepository {","\treturn \u0026MemoryRepository{orders: map[string]orders.Order{}}","}","","// Save stores an order under its id.","func (r *MemoryRepository) Save(order orders.Order) error {","\tr.mu.Lock()","\tdefer r.mu.Unlock()","\tr.orders[order.ID] = order","\treturn nil","}","","// Find returns the order with that id, or orders.ErrNotFound.","func (r *MemoryRepository) Find(id string) (orders.Order, error) {","\tr.mu.Lock()","\tdefer r.mu.Unlock()","\torder, ok := r.orders[id]","\tif !ok {","\t\treturn orders.Order{}, orders.ErrNotFound","\t}","\treturn order, nil","}",""],"internal/web/handler.go":["// Package web is the HTTP adapter: it turns requests into calls on the orders service.","package web","","import (","\t\"encoding/json\"","\t\"errors\"","\t\"log/slog\"","\t\"net/http\"","\t\"strconv\"","\t\"sync/atomic\"","\t\"time\"","","\t\"example.com/shop/internal/orders\"",")","","// Handler serves the orders API.","type Handler struct {","\tservice *orders.Service","\tlogger  *slog.Logger","\tmux     *http.ServeMux","}","","// NewHandler routes the API onto a service.","func NewHandler(service *orders.Service, logger *slog.Logger) *Handler {","\th := \u0026Handler{service: service, logger: logger, mux: http.NewServeMux()}","\th.mux.HandleFunc(\"POST /orders\", h.placeOrder)","\th.mux.HandleFunc(\"GET /orders/{id}\", h.getOrder)","\treturn h","}","","var requestCount atomic.Int64","","// ServeHTTP gives every request a correlation id and logs it on the way in and out.","func (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {","\tid := r.Header.Get(\"X-Request-ID\")","\tif id == \"\" {","\t\tid = \"req-\" + strconv.FormatInt(requestCount.Add(1), 10)","\t}","\tstarted := time.Now()","\th.logger.Info(\"request received\", \"request_id\", id, \"method\", r.Method, \"path\", r.URL.Path)","\trecorder := \u0026statusRecorder{ResponseWriter: w, status: http.StatusOK}","\trecorder.Header().Set(\"X-Request-ID\", id)","\th.mux.ServeHTTP(recorder, r)","\th.logger.Info(\"request completed\", \"request_id\", id, \"status\", recorder.status, \"duration_ms\", time.Since(started).Milliseconds())","}","","func (h *Handler) placeOrder(w http.ResponseWriter, r *http.Request) {","\tvar order orders.Order","\tif err := json.NewDecoder(r.Body).Decode(\u0026order); err != nil {","\t\twriteJSON(w, http.StatusUnprocessableEntity, map[string]string{\"error\": \"malformed order: \" + err.Error()})","\t\treturn","\t}","\tplacement, err := h.service.Place(order)","\tif err != nil {","\t\th.logger.Error(\"placing order failed\", \"error\", err)","\t\twriteJSON(w, http.StatusInternalServerError, map[string]string{\"error\": \"internal error\"})","\t\treturn","\t}","\twriteJSON(w, http.StatusOK, placement)","}","","func (h *Handler) getOrder(w http.ResponseWriter, r *http.Request) {","\torder, err := h.service.Get(r.PathValue(\"id\"))","\tif errors.Is(err, orders.ErrNotFound) {","\t\twriteJSON(w, http.StatusNotFound, map[string]string{\"error\": err.Error()})","\t\treturn","\t}","\twriteJSON(w, http.StatusOK, map[string]any{\"order\": order, \"totalCents\": order.TotalCents()})","}","","func writeJSON(w http.ResponseWriter, status int, body any) {","\tw.Header().Set(\"Content-Type\", \"application/json\")","\tw.WriteHeader(status)","\t_ = json.NewEncoder(w).Encode(body)","}","","type statusRecorder struct {","\thttp.ResponseWriter","\tstatus int","}","","func (s *statusRecorder) WriteHeader(status int) {","\ts.status = status","\ts.ResponseWriter.WriteHeader(status)","}",""]},"version":2}