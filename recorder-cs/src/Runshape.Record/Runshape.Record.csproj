<Project Sdk="Microsoft.NET.Sdk">
  <!-- runshape-cs: copies a .NET solution, instruments the copy with Roslyn, runs dotnet test. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>runshape-cs</AssemblyName>
    <RootNamespace>Runshape.Record</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built alongside, so the recorder can hand each recorded project the runtime's DLL. -->
    <ProjectReference Include="../Runshape.Runtime/Runshape.Runtime.csproj" />
  </ItemGroup>
</Project>
