diff --git a/tests/test_user_journeys.py b/tests/test_user_journeys.py
new file mode 100644
index 0000000..fc640f0
--- /dev/null
+++ b/tests/test_user_journeys.py
@@ -0,0 +1,124 @@
+"""RealWorld ("Conduit") user journeys, end to end through Django's test client.
+
+Added by hexvis: the upstream project ships without tests. Each test is one named user
+behaviour, so each becomes one scenario in the HexVis viewer.
+"""
+import json
+
+import pytest
+
+pytestmark = pytest.mark.django_db
+
+JSON = "application/json"
+
+
+def post(client, path, payload, token=None):
+    headers = {"HTTP_AUTHORIZATION": f"Token {token}"} if token else {}
+    return client.post(path, data=json.dumps(payload), content_type=JSON, **headers)
+
+
+def get(client, path, token=None):
+    headers = {"HTTP_AUTHORIZATION": f"Token {token}"} if token else {}
+    return client.get(path, **headers)
+
+
+def register(client, username):
+    response = post(client, "/api/users", {"user": {"username": username, "email": f"{username}@example.com", "password": "correct-horse-battery"}})
+    assert response.status_code == 201, response.content
+    return response.json()["user"]["token"]
+
+
+def publish(client, token, title, tags):
+    response = post(client, "/api/articles", {"article": {"title": title, "description": "desc", "body": "body", "tagList": tags}}, token)
+    assert response.status_code == 201, response.content
+    return response.json()["article"]
+
+
+def test_visitor_registers_an_account(client):
+    response = post(client, "/api/users", {"user": {"username": "ada", "email": "ada@example.com", "password": "correct-horse-battery"}})
+
+    assert response.status_code == 201
+    user = response.json()["user"]
+    assert {k: user[k] for k in ("username", "email")} == {"username": "ada", "email": "ada@example.com"}
+    assert user["token"]
+
+
+def test_member_logs_in_and_reads_their_profile(client):
+    register(client, "grace")
+
+    login = post(client, "/api/users/login", {"user": {"email": "grace@example.com", "password": "correct-horse-battery"}})
+    token = login.json()["user"]["token"]
+    me = get(client, "/api/user", token)
+
+    assert login.status_code == 200
+    assert me.status_code == 200
+    assert me.json()["user"]["username"] == "grace"
+
+
+def test_author_publishes_a_tagged_article(client):
+    token = register(client, "linus")
+
+    article = publish(client, token, "Hello Hexagons", ["architecture", "python"])
+
+    assert article["slug"].startswith("hello-hexagons")
+    assert sorted(article["tagList"]) == ["architecture", "python"]
+    assert article["author"]["username"] == "linus"
+
+
+def test_reader_browses_articles_by_tag(client):
+    token = register(client, "barbara")
+    publish(client, token, "About Onions", ["architecture"])
+    publish(client, token, "About Cats", ["pets"])
+
+    response = get(client, "/api/articles?tag=architecture")
+
+    assert response.status_code == 200
+    assert [a["title"] for a in response.json()["articles"]] == ["About Onions"]
+
+
+def test_reader_favorites_and_comments_on_an_article(client):
+    author = register(client, "edsger")
+    reader = register(client, "donald")
+    slug = publish(client, author, "Goto Considered", ["history"])["slug"]
+
+    favorite = post(client, f"/api/articles/{slug}/favorite", {}, reader)
+    comment = post(client, f"/api/articles/{slug}/comments", {"comment": {"body": "Indeed."}}, reader)
+
+    assert favorite.status_code == 201
+    assert favorite.json()["article"]["favorited"] is True
+    assert favorite.json()["article"]["favoritesCount"] == 1
+    assert comment.status_code == 201
+    assert comment.json()["comment"]["body"] == "Indeed."
+
+
+def test_reader_follows_an_author(client):
+    register(client, "alan")
+    follower = register(client, "joan")
+
+    follow = post(client, "/api/profiles/alan/follow", {}, follower)
+
+    assert follow.status_code == 201
+    assert follow.json()["profile"]["following"] is True
+
+
+@pytest.mark.xfail(
+    strict=True,
+    reason="Upstream bug: the router's articles/<slug> route is registered before "
+    "articles/feed, so 'feed' is looked up as an article slug and 404s.",
+)
+def test_follower_sees_followed_authors_in_their_feed(client):
+    author = register(client, "alan")
+    follower = register(client, "joan")
+    publish(client, author, "Computable Numbers", ["math"])
+    post(client, "/api/profiles/alan/follow", {}, follower)
+
+    feed = get(client, "/api/articles/feed", follower)
+
+    assert feed.status_code == 200
+    assert [a["title"] for a in feed.json()["articles"]] == ["Computable Numbers"]
+
+
+def test_anonymous_visitor_cannot_publish(client):
+    response = post(client, "/api/articles", {"article": {"title": "Spam", "description": "d", "body": "b", "tagList": []}})
+
+    assert response.status_code == 403
